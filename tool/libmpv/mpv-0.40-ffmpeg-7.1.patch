diff --git a/nix/packages/mk-pkg-libplacebo/default.nix b/nix/packages/mk-pkg-libplacebo/default.nix
new file mode 100644
index 0000000..69fc5aa
--- /dev/null
+++ b/nix/packages/mk-pkg-libplacebo/default.nix
@@ -0,0 +1,98 @@
+{
+  pkgs ? import ../../utils/default/pkgs.nix,
+  os ? import ../../utils/default/os.nix,
+  arch ? pkgs.callPackage ../../utils/default/arch.nix { },
+}:
+
+let
+  name = "libplacebo";
+  lock = import ../../../packages.lock.nix;
+  packageLock = lock.${name};
+  inherit (packageLock) version;
+
+  callPackage = pkgs.lib.callPackageWith { inherit pkgs os arch; };
+  nativeFile = callPackage ../../utils/native-file/default.nix { };
+  crossFile = callPackage ../../utils/cross-file/default.nix { };
+  xctoolchainInstallNameTool = callPackage ../../utils/xctoolchain/install-name-tool.nix { };
+  # meson's install step rewrites rpaths on darwin and shells out to otool.
+  xctoolchainOtool = callPackage ../../utils/xctoolchain/otool.nix { };
+
+  pname = import ../../utils/name/package.nix name;
+  src = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "${pname}-source-${version}";
+    inherit (packageLock) url sha256;
+  };
+
+  # Upstream keeps these as git submodules under 3rdparty/ and the source
+  # tarball ships the dirs empty: glad/jinja/markupsafe are imported from
+  # PYTHONPATH (python_env in meson.build) to generate the GL headers;
+  # Vulkan-Headers is included unconditionally even with -Dvulkan=disabled
+  # (vulkan/stubs.c, libplacebo/vulkan.h); fast_float headers are added to
+  # the include path when present.
+  fetch3rdparty =
+    dep:
+    callPackage ../../utils/fetch-tarball/default.nix {
+      name = "${pname}-3rdparty-${dep}";
+      inherit (lock."${name}-${dep}") url sha256;
+    };
+in
+
+# mpv >= 0.38 makes libplacebo a hard dependency. Only the OpenGL
+# backend is needed: media_kit renders through MPV_RENDER_API_TYPE_OPENGL
+# into a Flutter texture (vo=libmpv). Vulkan/Metal/D3D11 paths stay off.
+pkgs.stdenvNoCC.mkDerivation {
+  name = "${pname}-${os}-${arch}-${version}";
+  pname = pname;
+  inherit version;
+  inherit src;
+  dontUnpack = true;
+  enableParallelBuilding = true;
+  nativeBuildInputs = [
+    pkgs.meson
+    pkgs.ninja
+    pkgs.pkg-config
+    pkgs.python3
+    xctoolchainInstallNameTool
+    xctoolchainOtool
+  ];
+  configurePhase = ''
+    cp -R $src src-tree
+    chmod -R u+w src-tree/3rdparty
+    cp -R ${fetch3rdparty "glad"}/. src-tree/3rdparty/glad/
+    cp -R ${fetch3rdparty "jinja"}/. src-tree/3rdparty/jinja/
+    cp -R ${fetch3rdparty "markupsafe"}/. src-tree/3rdparty/markupsafe/
+    cp -R ${fetch3rdparty "fast-float"}/. src-tree/3rdparty/fast_float/
+    cp -R ${fetch3rdparty "vulkan-headers"}/. src-tree/3rdparty/Vulkan-Headers/
+    meson setup build src-tree \
+      --native-file ${nativeFile} \
+      --cross-file ${crossFile} \
+      --prefix=$out \
+      -Ddefault_library=shared \
+      -Dvulkan=disabled \
+      -Dvk-proc-addr=disabled \
+      -Dopengl=enabled \
+      -Dgl-proc-addr=disabled \
+      -Dd3d11=disabled \
+      -Dglslang=disabled \
+      -Dshaderc=disabled \
+      -Dlcms=disabled \
+      -Ddovi=disabled \
+      -Dlibdovi=disabled \
+      -Dunwind=disabled \
+      -Dxxhash=disabled \
+      -Ddemos=false \
+      -Dtests=false \
+      -Dbench=false \
+      -Dfuzz=false
+  '';
+  buildPhase = ''
+    meson compile -vC build
+  '';
+  installPhase = ''
+    meson install -C build
+    for file in $out/lib/libplacebo*.dylib; do
+      [ -L "$file" ] && continue
+      install_name_tool -id @rpath/$(basename $file) $file
+    done
+  '';
+}
